<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device transfer. Server accounts hold passwords encrypted with an
    Android Keystore key that never leaves this device, so they are useless anywhere else and
    must not be copied: sign in again after a restore or transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/accounts.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/accounts.json" />
    </device-transfer>
</data-extraction-rules>
