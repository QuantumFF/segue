<?xml version="1.0" encoding="utf-8"?>
<!--
    The strip in the widget picker below Android 15 (provider info's previewImage): Strip() at the
    340x88dp size of its generated preview, without art. Bars stand in for the title and artist.
    Icons are Lucide (ISC), as in widget_disc, widget_skip_back, widget_play and widget_skip_forward.
    Larger than lint's 200dp vector limit: the picker draws it once, at the widget's size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="340dp"
    android:height="88dp"
    android:viewportWidth="340"
    android:viewportHeight="88"
    tools:ignore="VectorRaster">
    <group>
        <clip-path android:pathData="@string/widget_strip_preview_outline" />
        <path
            android:fillColor="@color/widget_preview_surface"
            android:pathData="M0,0 H340 V88 H0 Z" />
        <!-- The art placeholder: full height, flush left. -->
        <path
            android:fillColor="@color/widget_preview_placeholder"
            android:pathData="M0,0 H88 V88 H0 Z" />
    </group>
    <group
        android:scaleX="1.3333"
        android:scaleY="1.3333"
        android:translateX="28"
        android:translateY="28">
        <path
            android:pathData="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0z M6 12c0-1.7.7-3.2 1.8-4.2 M10 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0z M18 12c0 1.7-.7 3.2-1.8 4.2"
            android:strokeWidth="2"
            android:strokeColor="@color/widget_preview_on_surface_variant"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <!-- Title and artist. -->
    <path
        android:fillColor="@color/widget_preview_on_surface"
        android:pathData="M105,30 H159 A5,5 0 0 1 159,40 H105 A5,5 0 0 1 105,30 Z" />
    <path
        android:fillColor="@color/widget_preview_on_surface_variant"
        android:pathData="M104,49 H140 A4,4 0 0 1 140,57 H104 A4,4 0 0 1 104,49 Z" />
    <!-- Previous, play and next, on 48dp targets ending 4dp from the edge. -->
    <group
        android:translateX="204"
        android:translateY="32">
        <path
            android:pathData="M17.971 4.285A2 2 0 0 1 21 6v12a2 2 0 0 1-3.029 1.715l-9.997-5.998a2 2 0 0 1-.003-3.432z M3 20V4"
            android:strokeWidth="2"
            android:strokeColor="@color/widget_preview_on_surface"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <path
        android:fillColor="@color/widget_preview_primary"
        android:pathData="M240,44 A24,24 0 1 1 288,44 A24,24 0 1 1 240,44 Z" />
    <group
        android:translateX="252"
        android:translateY="32">
        <path
            android:fillColor="@color/widget_preview_on_primary"
            android:pathData="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
            android:strokeWidth="2"
            android:strokeColor="@color/widget_preview_on_primary"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <group
        android:translateX="288"
        android:translateY="32">
        <path
            android:pathData="M21 4v16 M6.029 4.285A2 2 0 0 0 3 6v12a2 2 0 0 0 3.029 1.715l9.997-5.998a2 2 0 0 0 .003-3.432z"
            android:strokeWidth="2"
            android:strokeColor="@color/widget_preview_on_surface"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
