<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hearing Bluetooth audio devices connect, for "Play when Bluetooth connects". -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Browse callers checked against the allowlist (BrowseCallerPolicy) must be visible. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.android.systemui" />
        <package android:name="com.android.car.media" />
        <package android:name="com.android.car.carlauncher" />
    </queries>

    <application>
        <!-- Android Auto: a media app browsed through the service below. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".SeguePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Media buttons (a headset's play) reach the service even when it is not running. With
             nothing queued, play resumes this device's saved queue. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- "Play when Bluetooth connects". The broadcast is guarded by BLUETOOTH_CONNECT and is
             exempt from the implicit-broadcast limits on manifest receivers. -->
        <receiver
            android:name=".bluetooth.BluetoothAutoplayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Cover art for media browsers; read access is granted per browser. -->
        <provider
            android:name=".browse.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
