{
  "env": {
    "ANDROID_SERIAL": "emulator-5580"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-device.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
